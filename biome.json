{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": false,
                "source": ":URL:"
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [
                  ":NODE:",
                  ":BUN:"
                ]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [
                  ":PACKAGE:",
                  "!src/**/*"
                ]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [
                  ":ALIAS:",
                  "src/**/*"
                ]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": [
                  "**/*.css",
                  "**/*.less"
                ]
              },
              ":BLANK_LINE:",
              {
                "type": false,
                "source": ":PATH:"
              },
              ":BLANK_LINE:",
              {
                "type": true
              }
            ]
          }
        }
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": "off"
    }
  }
}